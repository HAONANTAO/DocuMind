PORT=3001
NODE_ENV=development
# Comma-separated list of allowed origins for CORS.
# In production NODE_ENV=production this is REQUIRED — the server refuses to start without it.
# In development requests from http://localhost:* are always accepted.
ALLOWED_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/documind?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_random_string_at_least_32_characters_long
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=documind
OPENAI_API_KEY=your_openai_api_key
